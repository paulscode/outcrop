From e1d34c55a14a3e544caf5b5d57af9caed2119a54 Mon Sep 17 00:00:00 2001
From: Outcrop <outcrop@localhost>
Date: Sat, 31 Oct 2026 16:20:46 -0500
Subject: [PATCH 2/6] sm_52: dense_f32 route accepted on Maxwell, interleaved
 matvec table (Titan X seed values from upstream PR 3596)

---
 src/kernels/cuda/native_mmvq.cu | 14 +++++++++++++-
 src/prefill/gemm.cu             |  2 +-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/kernels/cuda/native_mmvq.cu b/src/kernels/cuda/native_mmvq.cu
index 21d3392..afc7381 100644
--- a/src/kernels/cuda/native_mmvq.cu
+++ b/src/kernels/cuda/native_mmvq.cu
@@ -3645,6 +3645,15 @@ constexpr IlRows kIlRowsShared[] = {   // sm_86 + sm_120, and the fallback for e
 // Volta (sm_70): read off mmvq_il_parity --bench on a V100-SXM2-32GB (two runs, mean), the same rule - per cell the
 // rows count whose every measured shape takes at least 3% off native_mmvq's time (e.g. the Q5_K head at 3 columns
 // 1094 -> 821 us, Q6_K 12288 rows 68.9 -> 47.9 us), else 0; unmeasured classes take a neighbour's value (PR 1401)
+// Maxwell (sm_52): read off mmvq_il_parity --bench --emit-table, first on a GTX TITAN X (upstream PR 3596).  Bitwise equal to
+// native_mmvq.  STRATA_SM52_TABLE=0 keeps native_mmvq's kernels.
+constexpr IlRows kIlRows_52[] = {
+    {23, {{0, 1, 2, 1, 4}, {0, 0, 0, 1, 1}, {0, 0, 0, 2, 2}}},   // IQ4_XS
+    {12, {{0, 2, 1, 2, 2}, {0, 0, 1, 1, 1}, {0, 1, 0, 0, 0}}},   // Q4_K
+    {13, {{0, 1, 1, 2, 0}, {0, 1, 4, 0, 0}, {0, 2, 2, 2, 0}}},   // Q5_K
+    {14, {{0, 0, 4, 1, 4}, {0, 2, 0, 0, 1}, {0, 0, 4, 1, 0}}},   // Q6_K
+    {11, {{0, 0, 0, 1, 0}, {0, 1, 0, 1, 1}, {0, 4, 0, 0, 0}}},   // Q3_K
+};
 constexpr IlRows kIlRows_70[] = {
     {23, {{0, 2, 2, 2, 2}, {0, 2, 2, 2, 2}, {0, 4, 2, 2, 2}}},   // IQ4_XS
     {12, {{0, 2, 2, 4, 4}, {0, 2, 2, 2, 2}, {0, 2, 2, 2, 2}}},   // Q4_K
@@ -3807,6 +3816,7 @@ bool il_89_opt_in() {
 }
 struct IlArch { int cc; const IlRows* t; size_t n; };
 constexpr IlArch kIlArch[] = {
+    {52, kIlRows_52, sizeof(kIlRows_52) / sizeof(IlRows)},   // Maxwell GM200
     {60, kIlRows_60, sizeof(kIlRows_60) / sizeof(IlRows)},   // Pascal GP100: measured on a Tesla P100
     {61, kIlRows_61, sizeof(kIlRows_61) / sizeof(IlRows)},   // Pascal with dp4a: measured on a Tesla P40
     {75, kIlRows_75, sizeof(kIlRows_75) / sizeof(IlRows)},   // Turing: measured on an RTX 2080 Ti
@@ -3937,6 +3947,7 @@ bool sm60_table_on() { const char* v = std::getenv("STRATA_SM60_TABLE"); return
 // Pascal (sm_61: Tesla P40 / P4, GTX 10 series; native dp4a): the same interleaved kernels (bitwise equal to
 // native_mmvq's, mmvq_il_parity), its own table kIlRows_61.  STRATA_SM61_TABLE=0 keeps native_mmvq's kernels.
 bool sm61_table_on() { const char* v = std::getenv("STRATA_SM61_TABLE"); return v == nullptr || std::atoi(v) != 0; }
+bool sm52_table_on() { const char* v = std::getenv("STRATA_SM52_TABLE"); return v == nullptr || std::atoi(v) != 0; }
 bool il_arch_ok() {
     static int ok[16] = {};   // 0 unknown, 1 yes, -1 no, by device ordinal
     int dev = 0;
@@ -3947,7 +3958,8 @@ bool il_arch_ok() {
         cudaDeviceGetAttribute(&minor, cudaDevAttrComputeCapabilityMinor, dev);
         ok[dev] = (cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev) == cudaSuccess &&
                    (major >= 8 || (major == 7 && minor == 0 && sm70_opt_in()) || (major == 7 && minor == 5 && sm75_il_on(major, minor)) ||
-                    (major == 6 && minor == 0 && sm60_table_on()) || (major == 6 && minor == 1 && sm61_table_on()))) ? 1 : -1;
+                    (major == 6 && minor == 0 && sm60_table_on()) || (major == 6 && minor == 1 && sm61_table_on()) ||
+                    (major == 5 && sm52_table_on()))) ? 1 : -1;
     }
     return ok[dev] > 0;
 }
diff --git a/src/prefill/gemm.cu b/src/prefill/gemm.cu
index ebc558f..8c24e09 100644
--- a/src/prefill/gemm.cu
+++ b/src/prefill/gemm.cu
@@ -890,7 +890,7 @@ bool dense_f32_on() {
     if (g_dense_f32 >= 0) return g_dense_f32 != 0;
     if (!env) return false;
     const int cc = current_cc();
-    return cc >= 60 && cc < 70;
+    return cc >= 50 && cc < 70;   // Maxwell too: no tensor-core path for this call (gemm_f32_parity checks the bits)
 }
 // The smallest T taken for a weight of N rows and K columns (0: never): the measured shapes only - the 2560-column
 // qkv (10240 rows), query (12288) and gate (6144) projections and the 2560-row output projections (6144 and 4096
-- 
