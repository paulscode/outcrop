From b1484d7adde4361f79454d7387145c34a4a17bf3 Mon Sep 17 00:00:00 2001
From: Outcrop <outcrop@localhost>
Date: Sat, 31 Oct 2026 15:57:01 -0500
Subject: [PATCH 1/6] sm_52: build and runtime floor for Quadro M6000
 (moe_ws_down guard from upstream PR 4769, device floor, setup card check)

---
 setup.py                   | 2 +-
 src/core/device.cu         | 4 ++--
 src/prefill/moe_ws_down.cu | 4 ++++
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/setup.py b/setup.py
index 26b6661..940f3c5 100644
--- a/setup.py
+++ b/setup.py
@@ -1863,7 +1863,7 @@ def experimental_sm60() -> bool:
 
 
 def sm60_card(arch) -> bool:
-    return 60 <= int(arch) <= 70
+    return 52 <= int(arch) <= 70
 
 
 def maxwell_card(arch) -> bool:
diff --git a/src/core/device.cu b/src/core/device.cu
index 5c59554..e90a4fa 100644
--- a/src/core/device.cu
+++ b/src/core/device.cu
@@ -309,8 +309,8 @@ DeviceInfo device_info(int ordinal) {
     // #236: the experimental build (-DSTRATA_EXPERIMENTAL_SM60=ON: Pascal sm_60, Volta sm_70) runs on the cards it
     // was built for - refusing them below 7.5 there made the flag useless; the release engine keeps 7.5
 #if defined(STRATA_EXPERIMENTAL_SM60)
-    constexpr int kMinCc = 60;
-    const char* const kNeed = "6.0 or newer (this is the experimental Pascal / Volta build)";
+    constexpr int kMinCc = 52;
+    const char* const kNeed = "5.2 or newer (this is the experimental Maxwell / Pascal / Volta build)";
 #else
     constexpr int kMinCc = 75;
     const char* const kNeed = "7.5 or newer (RTX 20 / 30 / 40 / 50 series)";
diff --git a/src/prefill/moe_ws_down.cu b/src/prefill/moe_ws_down.cu
index 346f3a8..a381137 100644
--- a/src/prefill/moe_ws_down.cu
+++ b/src/prefill/moe_ws_down.cu
@@ -6,6 +6,8 @@
 // layer's rows: [k/128][rows] block_q8_1_mmq, of which blocks 0-4 are read.  (Measured on a GP100 die: ws / per-group
 // MMQ 0.24-0.29 at 2.5 rows per expert, 0.38-0.49 at 10, 0.52-0.68 at 35, 0.61-0.74 at 160; bit-identical,
 // compute-sanitizer clean with exact-size matrices.)
+// Upstream PR 4769: GP100-only kernels that use HFMA2, which ptxas accepts from sm_53.  Empty device pass below sm_53.
+#if !defined(__CUDA_ARCH__) || __CUDA_ARCH__ >= 530
 #include "common.cuh"
 #include "mmq.cuh"
 
@@ -643,3 +645,5 @@ void dn_iq4_nl(const Layer& L, double u, cudaStream_t s, bool fast) {
 }
 
 }  // namespace strata::prefill::ws::detail
+
+#endif  // !defined(__CUDA_ARCH__) || __CUDA_ARCH__ >= 530
-- 
2.43.0

