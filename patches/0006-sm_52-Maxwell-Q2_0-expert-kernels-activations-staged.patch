From 8488d827f01b1c1c81d6a29fa6fc45aacbeefd2f Mon Sep 17 00:00:00 2001
From: Outcrop <outcrop@localhost>
Date: Sat, 31 Oct 2026 17:58:29 -0500
Subject: [PATCH 6/6] sm_52: Maxwell Q2_0 expert kernels: activations staged
 transposed, codes expanded once per row (STRATA_Q2F)

---
 src/kernels/cuda/iq_kernels.cu | 220 ++++++++++++++++++++++++++++++++-
 1 file changed, 219 insertions(+), 1 deletion(-)

diff --git a/src/kernels/cuda/iq_kernels.cu b/src/kernels/cuda/iq_kernels.cu
index 85f4cab..c9b96bc 100644
--- a/src/kernels/cuda/iq_kernels.cu
+++ b/src/kernels/cuda/iq_kernels.cu
@@ -6059,6 +6059,220 @@ __global__ void __launch_bounds__(256) native_down_lds_kernel(const unsigned lon
     }
 }
 
+// ---- Q2_0 for cards without __dp4a (STRATA_Q2F, on in mode 8 unless =0).  vec_dot_q2_0_q8_1 maps every code to {-1, 0, 1, 2}
+// through two __byte_perm per 8 values and redoes that for every (row, token).  Here the sum is written (sum c x) - (sum x), the
+// form s2_expert_grouped.cu uses: the activations go into shared memory once, regrouped so that a code word's bytes pair with them
+// directly, with `hx` = sum x kept per chunk, and a row's codes are expanded once for all of its tokens.  The integers are
+// vec_dot_q2_0_q8_1's and the float expression is its own, so the outputs are the same bits.
+__device__ __forceinline__ void q2f_expand(uint32_t cl, uint32_t ch, int m[8]) {
+    const uint32_t M = 0x03030303u;
+#pragma unroll
+    for (int f = 0; f < 4; ++f) {
+        m[f] = (int) ((cl >> (2 * f)) & M);
+        m[4 + f] = (int) ((ch >> (2 * f)) & M);
+    }
+}
+__device__ __forceinline__ int q2f_dots(const int m[8], const int X[8]) {
+    int s = 0;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) s = STRATA_DP4A(m[j], X[j], s);
+    return s;
+}
+// Chunk `i` of the staging: one q8_1 block regrouped into xs_w[j * STRIDE + i], with (d, hx) in xs_dh[i].
+template<int STRIDE>
+__device__ __forceinline__ void q2f_stage(const block_q8_1* __restrict__ b, int* xs_w, int2* xs_dh, int i) {
+    const unsigned* w = reinterpret_cast<const unsigned*>(b->qs);
+    unsigned n[8];
+    int hx = 0;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        n[j] = w[j];
+        hx = STRATA_DP4A(0x01010101, (int) n[j], hx);
+    }
+#pragma unroll
+    for (int h = 0; h < 2; ++h) {
+        const unsigned t0 = __byte_perm(n[4 * h], n[4 * h + 1], 0x5140);
+        const unsigned t1 = __byte_perm(n[4 * h], n[4 * h + 1], 0x7362);
+        const unsigned t2 = __byte_perm(n[4 * h + 2], n[4 * h + 3], 0x5140);
+        const unsigned t3 = __byte_perm(n[4 * h + 2], n[4 * h + 3], 0x7362);
+        xs_w[(4 * h + 0) * STRIDE + i] = (int) __byte_perm(t0, t2, 0x5410);
+        xs_w[(4 * h + 1) * STRIDE + i] = (int) __byte_perm(t0, t2, 0x7632);
+        xs_w[(4 * h + 2) * STRIDE + i] = (int) __byte_perm(t1, t3, 0x5410);
+        xs_w[(4 * h + 3) * STRIDE + i] = (int) __byte_perm(t1, t3, 0x7632);
+    }
+    xs_dh[i] = make_int2(__float_as_int(__low2float(b->ds)), hx);
+}
+// One row's codes of the 8-byte chunk iqs of block kbx: four 2-byte loads (a block is 18 bytes, so its codes are not word aligned)
+__device__ __forceinline__ void q2f_load(const block_q2_0* __restrict__ b, int iqs, uint32_t& cl, uint32_t& ch) {
+    const uint16_t* q = reinterpret_cast<const uint16_t*>(b->qs) + iqs * 4;
+    cl = (uint32_t) q[0] | ((uint32_t) q[1] << 16);
+    ch = (uint32_t) q[2] | ((uint32_t) q[3] << 16);
+}
+
+// native_gu_fused_kernel<42> on the above
+__global__ void __launch_bounds__(256) native_gu_fused_q2_kernel(const unsigned long long* __restrict__ grp_ptr,
+                                                                 const int32_t* __restrict__ grp_start,
+                                                                 const int32_t* __restrict__ n_groups,
+                                                                 const int32_t* __restrict__ ent_tok,
+                                                                 const block_q8_1* __restrict__ xq, NativeExpertLayout L,
+                                                                 block_q8_1* __restrict__ hq) {
+    constexpr int NC = 80, STRIDE = LDS_NT * NC;
+    __shared__ float res[LDS_NT][64];
+    __shared__ int xs_w[8 * STRIDE];
+    __shared__ int2 xs_dh[STRIDE];
+    const int g = blockIdx.y;
+    if (g >= *n_groups) return;
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const uint8_t* blob = (const uint8_t*) grp_ptr[g];
+    const int hb = (int) (L.n_ff / 32);
+    const int e0 = grp_start[g], e1 = grp_start[g + 1];
+    const int r0 = blockIdx.x * 32;
+    auto wrow = [&](int i) -> const block_q2_0* {   // i < 32: gate row r0 + i, else up row r0 + i - 32
+        return (const block_q2_0*) (blob + (i < 32 ? (size_t) 0 : L.up_off) + (size_t) (r0 + (i & 31)) * L.gu_row);
+    };
+    for (int c0 = e0; c0 < e1; c0 += LDS_NT) {
+        const int cn = min(LDS_NT, e1 - c0);
+        __syncthreads();
+        for (int i = tid; i < cn * NC; i += 256) {
+            const int j = i / NC, c = i - j * NC;
+            q2f_stage<STRIDE>(xq + (size_t) ent_tok[c0 + j] * NC + c, xs_w, xs_dh, i);
+        }
+        __syncthreads();
+        for (int p = 0; p < 4; ++p) {
+            const int i0 = p * 16 + warp, i1 = i0 + 8;
+            const block_q2_0* w0 = wrow(i0);
+            const block_q2_0* w1 = wrow(i1);
+            auto pass = [&](auto ntc) {
+                constexpr int NTC = decltype(ntc)::value;
+                float s0[NTC], s1[NTC];
+#pragma unroll
+                for (int j = 0; j < NTC; ++j) { s0[j] = 0.0f; s1[j] = 0.0f; }
+                for (int k = lane; k < NC; k += 32) {
+                    const int kbx = k / 2, iqs = k % 2;
+                    const float d0 = w0[kbx].d, d1 = w1[kbx].d;
+                    uint32_t c0l, c0h, c1l, c1h;
+                    q2f_load(w0 + kbx, iqs, c0l, c0h);
+                    q2f_load(w1 + kbx, iqs, c1l, c1h);
+                    int m0[8], m1[8];
+                    q2f_expand(c0l, c0h, m0);
+                    q2f_expand(c1l, c1h, m1);
+#pragma unroll
+                    for (int j = 0; j < NTC; ++j) {
+                        const int at = j * NC + k;
+                        int X[8];
+#pragma unroll
+                        for (int b = 0; b < 8; ++b) X[b] = xs_w[b * STRIDE + at];
+                        const int2 dh = xs_dh[at];
+                        const float d8 = __int_as_float(dh.x);
+                        s0[j] += d0 * d8 * (q2f_dots(m0, X) - dh.y);
+                        s1[j] += d1 * d8 * (q2f_dots(m1, X) - dh.y);
+                    }
+                }
+#pragma unroll
+                for (int j = 0; j < NTC; ++j) {
+                    const float a = warp_sum(s0[j]), b = warp_sum(s1[j]);
+                    if (lane == 0) { res[j][i0] = a; res[j][i1] = b; }
+                }
+            };
+            switch (cn) {
+                case 1: pass(std::integral_constant<int, 1>{}); break;
+                case 2: pass(std::integral_constant<int, 2>{}); break;
+                case 3: pass(std::integral_constant<int, 3>{}); break;
+                default: pass(std::integral_constant<int, 4>{}); break;
+            }
+        }
+        __syncthreads();
+        if (warp < cn) {   // native_gu_fused_kernel's epilogue
+            const float gg = res[warp][lane], uu = res[warp][32 + lane];
+            const float xi = (gg / (1.0f + __expf(-gg))) * uu;
+            float amax = fabsf(xi), sum = xi;
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) {
+                amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+                sum += __shfl_xor_sync(0xffffffffu, sum, o);
+            }
+            const float d = q8_1_finite(amax / 127.0f);
+            const int8_t q = q8_1_quant(xi, d, amax);
+            block_q8_1* y = hq + (size_t) (c0 + warp) * hb + blockIdx.x;
+            y->qs[lane] = q;
+            if (lane == 0) y->ds = q8_1_ds(d, sum);
+        }
+    }
+}
+
+// native_down_lds_kernel<42> on the above
+__global__ void __launch_bounds__(256) native_down_q2_kernel(const unsigned long long* __restrict__ grp_ptr,
+                                                             const int32_t* __restrict__ grp_start,
+                                                             const int32_t* __restrict__ n_groups,
+                                                             const int32_t* __restrict__ ent_dst,
+                                                             const block_q8_1* __restrict__ hq, NativeExpertLayout L,
+                                                             float* __restrict__ out) {
+    constexpr int NC = 20, STRIDE = LDS_NT * NC;
+    __shared__ int hs_w[8 * STRIDE];
+    __shared__ int2 hs_dh[STRIDE];
+    const int g = blockIdx.y;
+    if (g >= *n_groups) return;
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const uint8_t* blob = (const uint8_t*) grp_ptr[g];
+    const int e0 = grp_start[g], e1 = grp_start[g + 1];
+    const int nrow = (int) L.n_embd;
+    for (int c0 = e0; c0 < e1; c0 += LDS_NT) {
+        const int cn = min(LDS_NT, e1 - c0);
+        __syncthreads();
+        for (int i = tid; i < cn * NC; i += 256) q2f_stage<STRIDE>(hq + (size_t) c0 * NC + i, hs_w, hs_dh, i);
+        __syncthreads();
+        for (int p = 0; p < LDS_RB / 16; ++p) {
+            const int r0 = blockIdx.x * LDS_RB + p * 16 + warp, r1 = r0 + 8;
+            if (r0 >= nrow) break;
+            const bool two = r1 < nrow;
+            const block_q2_0* w0 = (const block_q2_0*) (blob + L.down_off + (size_t) r0 * L.d_row);
+            const block_q2_0* w1 = (const block_q2_0*) (blob + L.down_off + (size_t) (two ? r1 : r0) * L.d_row);
+            auto pass = [&](auto ntc) {
+                constexpr int NTC = decltype(ntc)::value;
+                float s0[NTC], s1[NTC];
+#pragma unroll
+                for (int j = 0; j < NTC; ++j) { s0[j] = 0.0f; s1[j] = 0.0f; }
+                if (lane < NC) {   // a row is 20 chunks: one pass of the lanes
+                    const int k = lane, kbx = k / 2, iqs = k % 2;
+                    const float d0 = w0[kbx].d, d1 = w1[kbx].d;
+                    uint32_t c0l, c0h, c1l, c1h;
+                    q2f_load(w0 + kbx, iqs, c0l, c0h);
+                    q2f_load(w1 + kbx, iqs, c1l, c1h);
+                    int m0[8], m1[8];
+                    q2f_expand(c0l, c0h, m0);
+                    q2f_expand(c1l, c1h, m1);
+#pragma unroll
+                    for (int j = 0; j < NTC; ++j) {
+                        const int at = j * NC + k;
+                        int X[8];
+#pragma unroll
+                        for (int b = 0; b < 8; ++b) X[b] = hs_w[b * STRIDE + at];
+                        const int2 dh = hs_dh[at];
+                        const float d8 = __int_as_float(dh.x);
+                        s0[j] += d0 * d8 * (q2f_dots(m0, X) - dh.y);
+                        s1[j] += d1 * d8 * (q2f_dots(m1, X) - dh.y);
+                    }
+                }
+#pragma unroll
+                for (int j = 0; j < NTC; ++j) {
+                    const float a = warp_sum(s0[j]), b = warp_sum(s1[j]);
+                    if (lane == 0) {
+                        out[(size_t) ent_dst[c0 + j] * L.n_embd + r0] = a;
+                        if (two) out[(size_t) ent_dst[c0 + j] * L.n_embd + r1] = b;
+                    }
+                }
+            };
+            switch (cn) {
+                case 1: pass(std::integral_constant<int, 1>{}); break;
+                case 2: pass(std::integral_constant<int, 2>{}); break;
+                case 3: pass(std::integral_constant<int, 3>{}); break;
+                default: pass(std::integral_constant<int, 4>{}); break;
+            }
+        }
+    }
+}
+bool q2f_on() { static const bool on = [] { const char* v = std::getenv("STRATA_Q2F"); return v == nullptr || v[0] != '0'; }(); return on; }
+
 // ---- 8: mode 7's gate/up with SwiGLU and the q8_1 quantization in the epilogue.  A block takes h rows
 // [r0, r0 + 32): gate rows r0.. and up rows r0.. (64 weight rows, the same per-(row, entry) sums as mode 7), so
 // one 32-lane warp per entry holds exactly one q8_1 block of h and runs quantize_q8_1_kernel's own code on it -
@@ -6375,7 +6589,10 @@ void native_expert_grouped(const NativeExpertLayout& L, const unsigned long long
             case 18: native_gu_fused_kernel<18><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq); break;
             case 21: native_gu_fused_kernel<21><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq); break;
             case 23: native_gu_fused_kernel<23><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq); break;
-            case 42: native_gu_fused_kernel<42><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq); break;
+            case 42:
+                if (q2f_on()) native_gu_fused_q2_kernel<<<gl, 256, 0, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq);
+                else native_gu_fused_kernel<42><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq);
+                break;
             default: native_gu_fused_kernel<22><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq); break;
         }
         check("native_expert_grouped/gu fused");
@@ -6501,6 +6718,7 @@ void native_expert_grouped(const NativeExpertLayout& L, const unsigned long long
         const dim3 gl((unsigned) ((L.n_embd + LDS_RB - 1) / LDS_RB), (unsigned) cap_groups);
         const size_t sh = (size_t) LDS_NT * (size_t) (L.n_ff / 32) * sizeof(block_q8_1);
         if (L.d_type == 20) native_down_lds_kernel<20><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_dst, hq, L, out);
+        else if (q2f_on()) native_down_q2_kernel<<<gl, 256, 0, s>>>(grp_ptr, grp_start, n_groups, ent_dst, hq, L, out);
         else native_down_lds_kernel<42><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_dst, hq, L, out);
         check("native_expert_grouped/down");
         return;
