+            }
             if (locked > 0) strata::platform::unlock_resident((uint8_t*) arena + lock_off, locked);
             std::free(arena);
         }
@@ -3910,15 +3923,79 @@ bool FileExpertSource::pin_cache_complement(
                     return (uint64_t) ((v != nullptr && std::atof(v) > 0 ? std::atof(v) : 24.0) * 1073741824.0);
                 }();
                 if (paced) {
-                    // #1250: the pages are taken in 1 GiB steps by ordinary page faults (which reclaim file cache as
-                    // they need to), each only while the RAM available (the cgroup's room included) stays above the
-                    // reserve; then the pages that are there are page-locked in ONE registration (nothing is
-                    // allocated then, the driver only pins them), so a blob never straddles two registrations.  The
-                    // hottest experts come first in the arena: they are the pinned ones; the rest is locked pageable
-                    // memory, as when the driver refuses the page-locking.
+                    // #1250: the pages are taken in 1 GiB steps, each only while the RAM available (the cgroup's room
+                    // included) stays above the reserve, so the file cache is reclaimed step by step.  The hottest
+                    // experts come first in the arena: they are the pinned ones; the rest is locked pageable memory, as
+                    // when the driver refuses the page-locking.
+                    //
+                    // STRATA_PIN_SEGMENTS (default 1): each step is its own registration of about 1 GiB, made before
+                    // anything is written into it.  ONE registration of the touched arena (=0, the way before) can loop
+                    // for half an hour or more on kernels that type pageblocks as CMA with no CMA area: a long-term pin
+                    // migrates the pages it finds in those blocks and pins the whole range again, while compaction moves
+                    // other pages into them.  The pages a pin faults in itself are allocated outside those blocks, so
+                    // there is nothing to move, and a retry would redo one segment, not the arena.  Every cut is a
+                    // page-aligned blob start: no page is registered twice and no blob spans two registrations.
                     constexpr uint64_t kStep = 1ull << 30, kPage = 4096;
+                    static const bool segmented = [] {
+                        const char* v = std::getenv("STRATA_PIN_SEGMENTS");
+                        return v == nullptr || std::atoi(v) != 0;
+                    }();
                     uint64_t got = 0;
                     const char* stop = nullptr;
+                    if (segmented) {
+                        // the page-aligned blob starts, ascending: where a segment may end
+                        std::vector<uint64_t> cuts;
+                        cuts.reserve(offsets.size() / 4 + 1);
+                        for (size_t i = 0; i < offsets.size(); ++i)
+                            if (offsets[i] != kNoComplement && offsets[i] > 0 && offsets[i] < bytes && offsets[i] % kPage == 0)
+                                cuts.push_back(offsets[i]);
+                        std::sort(cuts.begin(), cuts.end());
+                        cuts.erase(std::unique(cuts.begin(), cuts.end()), cuts.end());
+                        const auto t0 = std::chrono::steady_clock::now();
+                        double slowest = 0.0;
+                        while (got < bytes) {
+                            uint64_t hi = bytes;
+                            if (got + kStep < bytes) {   // the last cut within the step, else the first one after it
+                                auto it = std::upper_bound(cuts.begin(), cuts.end(), got + kStep);
+                                if (it != cuts.begin() && *(it - 1) > got) hi = *(it - 1);
+                                else if (it != cuts.end()) hi = *it;
+                            }
+                            uint64_t avail_now = 0;
+                            if (!available_memory_bytes(avail_now) || !detail::pin_step_fits(avail_now, hi - got, pace_reserve)) {
+                                stop = "the RAM left would fall under the reserve";
+                                break;
+                            }
+#if defined(__linux__)
+                            if (numa.place) numa.touch_step((uint8_t*) arena, got, hi);   // slices on their nodes first
+#endif
+                            const auto s0 = std::chrono::steady_clock::now();
+                            void* alias = nullptr;
+                            if (cudaHostRegister((uint8_t*) arena + got, (size_t) (hi - got),
+                                                 cudaHostRegisterMapped | cudaHostRegisterPortable) != cudaSuccess) {
+                                (void) cudaGetLastError();
+                                stop = "the driver refused to page-lock it";
+                                break;
+                            }
+                            if (cudaHostGetDevicePointer(&alias, (uint8_t*) arena + got, 0) != cudaSuccess || alias == nullptr) {
+                                (void) cudaGetLastError();
+                                (void) cudaHostUnregister((uint8_t*) arena + got);
+                                stop = "no device alias";
+                                break;
+                            }
+                            slowest = std::max(slowest, std::chrono::duration<double>(std::chrono::steady_clock::now() - s0).count());
+                            segments.push_back({got, hi, (const uint8_t*) alias});
+                            if (segments.back().dev != segments.front().dev + (size_t) got) segments_contiguous = false;
+                            got = hi;
+                        }
+                        if (!segments.empty()) {
+                            device = segments.front().dev;
+                            partial_pin = got;
+                        }
+                        std::fprintf(stderr, "FileExpertSource: %.2f GiB page-locked in %zu segments in %.1f s (the slowest "
+                                             "%.1f s)%s\n", (double) partial_pin / 1073741824.0, segments.size(),
+                                     std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(), slowest,
+                                     segments_contiguous ? "" : "; their device aliases are not one run");
+                    } else {
                     while (got < bytes) {
                         const uint64_t step = std::min<uint64_t>(kStep, bytes - got);
                         uint64_t avail_now = 0;
@@ -3958,12 +4035,16 @@ bool FileExpertSource::pin_cache_complement(
                             if (stop == nullptr) stop = "the driver refused to page-lock it";
