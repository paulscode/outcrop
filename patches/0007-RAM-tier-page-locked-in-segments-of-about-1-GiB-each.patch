 include/strata/core/expert_source.hpp |   5 ++
 src/core/expert_source.cpp            | 111 +++++++++++++++++++++++---
 2 files changed, 106 insertions(+), 10 deletions(-)

diff --git a/include/strata/core/expert_source.hpp b/include/strata/core/expert_source.hpp
