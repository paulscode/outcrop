--- a/include/strata/core/expert_source.hpp
+++ b/include/strata/core/expert_source.hpp
@@ -1213,6 +1213,11 @@ private:
     bool complement_registered_ = false;      ///< the arena is ordinary memory registered with cudaHostRegister (not cudaHostAlloc)
     uint64_t complement_pin_limit_ = 0;
     uint64_t complement_lock_off_ = 0;        ///< the working-set lock covers [lock_off, lock_off + locked)
+    /// STRATA_PIN_SEGMENTS: the paced path's registrations of the arena, [lo, hi) each with the device alias of lo, in
+    /// order and back to back from 0 (so the registered part is still a prefix).  Empty: one registration, or none.
+    struct PinSegment { uint64_t lo = 0, hi = 0; const uint8_t* dev = nullptr; };
+    std::vector<PinSegment> complement_segments_;
+    bool complement_segments_contiguous_ = true;   ///< the aliases are one run: complement_device_ + offset holds
     bool complement_ready_ = false;
     uint64_t complement_locked_ = 0;          ///< bytes held in the working set (pin refused)
     int64_t complement_lent_slots_ = 0;
diff --git a/src/core/expert_source.cpp b/src/core/expert_source.cpp
index 4a872e8..3d0d080 100644
--- a/src/core/expert_source.cpp
