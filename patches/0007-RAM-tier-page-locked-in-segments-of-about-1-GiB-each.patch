     complement_pin_limit_ = 0;
     complement_lock_off_ = 0;
+    complement_segments_.clear();
+    complement_segments_contiguous_ = true;
     complement_ready_ = false;
     complement_locked_ = 0;
     complement_lent_slots_ = 0;
@@ -3734,6 +3741,8 @@ bool FileExpertSource::pin_cache_complement(
