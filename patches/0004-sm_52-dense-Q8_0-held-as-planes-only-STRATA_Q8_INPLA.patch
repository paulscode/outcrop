+#include "strata/kernels/native_mmvq.hpp"
 #include "strata/core/defaults_026.hpp"
 #include "strata/core/sm120_series.hpp"
 
@@ -327,6 +328,28 @@ __global__ void dequant_q8_0_kernel(const uint8_t* __restrict__ blocks, int64_t
     for (int k = 0; k < (int) (8 * sizeof(T) / 16); ++k) o[k] = ((const uint4*) v)[k];
 }
 
+// dequant_q8_0_kernel on a matrix held as planes (STRATA_Q8_INPLACE): the same value per element, read from the qs and d
+// planes.  Eight bytes a thread are one aligned load here, where the blocks needed four 2-byte loads.
+template <typename T>
+__global__ void dequant_q8_planes_kernel(const uint8_t* __restrict__ qs, const uint8_t* __restrict__ dpl, int64_t cols, int64_t row0,
+                                         int64_t rows, int64_t groups_per_row, T* __restrict__ out) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= rows * groups_per_row * 4) return;
+    const int64_t g = i >> 2, r = g / groups_per_row, gi = g % groups_per_row;
+    const int piece = (int) (i & 3);
+    const float d = h2f(dpl + ((row0 + r) * groups_per_row + gi) * 2);
+    const uint2 q = *(const uint2*) (qs + (row0 + r) * cols + gi * 32 + 8 * piece);
+    __align__(16) T v[8];
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        put(v, k, (float) (int8_t) (q.x >> (8 * k)) * d);
+        put(v, 4 + k, (float) (int8_t) (q.y >> (8 * k)) * d);
+    }
+    uint4* o = (uint4*) (out + g * 32 + 8 * piece);
+#pragma unroll
+    for (int k = 0; k < (int) (8 * sizeof(T) / 16); ++k) o[k] = ((const uint4*) v)[k];
+}
+
 bool geometry(int type, int& block_elems, int& block_bytes) {
     switch (type) {
     case 2: block_elems = 32; block_bytes = 18; return true;
@@ -358,6 +381,21 @@ void launch(int type, const void* blocks, int64_t row0, int64_t rows, int64_t co
     const unsigned grid = (unsigned) ((total + 255) / 256);
     const uint8_t* p = (const uint8_t*) blocks;
     cudaStream_t st = (cudaStream_t) stream;
+    if (type == 8) {
+        const void* qs = nullptr;
+        const void* dpl = nullptr;
+        if (native_q8_0_planes(blocks, &qs, &dpl)) {
+            if (ld != cols || (reinterpret_cast<uintptr_t>(out) & 15) != 0) {
+                std::fprintf(stderr, "dequant: a planes matrix needs contiguous aligned output\n");
+                std::exit(1);
+            }
+            dequant_q8_planes_kernel<T><<<(unsigned) ((4 * total + 255) / 256), 256, 0, st>>>((const uint8_t*) qs, (const uint8_t*) dpl, cols,
+                                                                                               row0, rows, gpr, out);
+            const cudaError_t e = cudaGetLastError();
+            if (e != cudaSuccess) { std::fprintf(stderr, "dequant launch: %s\n", cudaGetErrorString(e)); std::exit(1); }
+            return;
+        }
+    }
     if (type == 8 && ld == cols && (reinterpret_cast<uintptr_t>(blocks) & 1) == 0 &&
         (reinterpret_cast<uintptr_t>(out) & 15) == 0) {   // contiguous rows only (the kernel writes out + g * 32)
         dequant_q8_0_kernel<T><<<(unsigned) ((4 * total + 255) / 256), 256, 0, st>>>(p, row_bytes, row0, rows, gpr, out);
