                 all = q8sm60::launch(found->second.qs, found->second.d,
                                      static_cast<const Q81Block*>(x_q8_1) + std::size_t(j) * std::size_t(n_in / Q8K),
                                      y + std::size_t(j) * std::size_t(n_out), n_in, n_out, nj, static_cast<cudaStream_t>(stream));
@@ -2921,7 +2922,7 @@ bool native_q8_0_sm60_pack_in_place(void* weights, int n_in, int n_out, const ch
     if (q8_packed_registry().count(weights)) return true;
     // The GGUF blocks are gone afterwards, so only where q8_packed_mmvq can never fall back to the GGUF-layout kernels
     // (every column count fits the kernel's shared-memory planes) and its 16-byte weight loads stay aligned
-    if (q8sm60::smem_bytes(q8sm60::MAX_COLS, n_in) > q8sm60::MAX_SMEM || reinterpret_cast<std::uintptr_t>(weights) % 16 != 0)
+    if (q8sm60::smem_bytes(1, n_in) > q8sm60::MAX_SMEM || reinterpret_cast<std::uintptr_t>(weights) % 16 != 0)
         return native_q8_0_sm60_pack(weights, n_in, n_out, what);
     const std::size_t bytes = std::size_t(n_in / 32) * std::size_t(n_out) * 34;   // both layouts: 34 bytes per 32
     std::vector<uint8_t> blocks(bytes), planes(bytes);
@@ -2946,6 +2947,40 @@ bool native_q8_0_sm60_pack_in_place(void* weights, int n_in, int n_out, const ch
 #endif
 }
 
+// STRATA_Q8_INPLACE (on with STRATA_Q8_SM60 unless =0): a dense Q8_0 matrix is uploaded as its planes, in the bytes the GGUF
+// blocks would take, instead of the blocks plus a packed copy: 2.9 GiB of VRAM on Flash-Next, about 2,300 expert slots.
+// The one other reader of those blocks is the prompt path's dequantization, which takes the planes (dequant_bf16.cu).
+bool native_q8_0_inplace_on() {
+#if defined(__HIPCC__)
+    return false;
+#else
+    static const bool on = [] { const char* v = std::getenv("STRATA_Q8_INPLACE"); return q8_sm60_on() && (v == nullptr || v[0] != '0'); }();
+    return on;
+#endif
+}
+bool native_q8_0_inplace_fits(int n_in, int n_out, const void* weights) {
+#if defined(__HIPCC__)
+    (void) n_in; (void) n_out; (void) weights;
+    return false;
+#else
+    return native_q8_0_inplace_on() && native_q8_0_packed_eligible(n_in, n_out) &&
+           q8sm60::smem_bytes(1, n_in) <= q8sm60::MAX_SMEM && reinterpret_cast<std::uintptr_t>(weights) % 16 == 0;
+#endif
+}
+void native_q8_0_register_in_place(void* weights, int n_in, int n_out) {
+    native_q8_0_packed_register(weights, weights, n_in, n_out);
+    q8_sm60_owned()[weights] = nullptr;
+}
+bool native_q8_0_planes(const void* weights, const void** qs, const void** d) {
+    const auto owned = q8_sm60_owned().find(weights);
+    if (owned == q8_sm60_owned().end() || owned->second != nullptr) return false;
+    const auto found = q8_packed_registry().find(weights);
+    if (found == q8_packed_registry().end()) return false;
+    *qs = found->second.qs;
+    *d = found->second.d;
+    return true;
+}
+
 bool native_q6_k_packed_enabled() {
     static const bool enabled = [] {
         const char* v = std::getenv("STRATA_Q6_PACKED");
diff --git a/src/kernels/cuda/q8_sm60.cuh b/src/kernels/cuda/q8_sm60.cuh
index ef1d9fd..0398e4a 100644
--- a/src/kernels/cuda/q8_sm60.cuh
+++ b/src/kernels/cuda/q8_sm60.cuh
@@ -28,6 +28,13 @@ inline std::size_t smem_bytes(int ncols, int n_in) {
     return std::size_t(ncols) * std::size_t(n_in) + std::size_t(ncols) * std::size_t(n_in / 32) * sizeof(float);
 }
 
+// the most columns of an n_in-wide matrix one launch holds in shared memory (6144 -> 7; a window beyond it runs in passes)
+inline int max_cols(int n_in) {
+    int c = MAX_COLS;
+    while (c > 1 && smem_bytes(c, n_in) > MAX_SMEM) --c;
+    return c;
+}
