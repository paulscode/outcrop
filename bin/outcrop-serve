#!/usr/bin/env python3
"""outcrop-serve PRESET  - render PRESET's Strata config and replace this process with the Strata server (what the systemd unit runs).

The server listens on presets.json's server.host:server.port (loopback behind the API gateway; the LAN in a `outcrop gateway
bypass`) and serves the OpenAI and Anthropic APIs.  It stops on SIGTERM.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import strata_presets as SP  # noqa: E402

if len(sys.argv) != 2:
    sys.exit(__doc__)
name = sys.argv[1]
cfg = SP.load()
try:
    path, notes = SP.render(name, cfg)
except (KeyError, ValueError) as e:                      # an unknown or refused preset: say why, don't crash-loop
    sys.exit(f"outcrop-serve: {e.args[0]}")
for n in notes:
    print(f"outcrop-serve: {n}", flush=True)
host, port = SP.bind(cfg)
py = str(SP.STRATA / ".venv" / "bin" / "python")
argv = [py, "serve/server.py", "--engine", "strata", "--config", str(path), "--host", host, "--port", str(port)]
print(f"outcrop-serve: preset {name}: {' '.join(argv)}", flush=True)
os.chdir(SP.STRATA)
os.environ["LD_LIBRARY_PATH"] = SP.CUDA_LIB
os.environ["OUTCROP_PRESET"] = name
os.execv(py, argv)
