# pins.env  - every pinned source Outcrop builds or downloads, in one place.
#
# Read by setup/install.sh, setup/build-engine.sh, setup/download-models.sh and setup.sh (`. setup/pins.env`), and by
# the StartOS image's Dockerfile.  Plain KEY=value lines only: no spaces around =, no quotes, no $expansions, so every
# reader parses it the same way.  Change a pin here and nowhere else (console/tests/test_pins.py checks that).

# Strata v0.2.11 (Control and engine 0.1.57), and the llama.cpp commit it pins
STRATA_COMMIT=c3b3f5035506f3e966f1b4b7b188aeaabae92f1d
LLAMA_COMMIT=3cf03257f219afbe7334045ff7c6a06ac68c627d

# CUDA 12.9.1: CUDA 13 cannot compile for Maxwell (sm_52); 12.9 is the last 12.x
CUDA_RUN=cuda_12.9.1_575.57.08_linux.run
CUDA_URL=https://developer.download.nvidia.com/compute/cuda/12.9.1/local_installers/cuda_12.9.1_575.57.08_linux.run

# Qwen3.8-Flash-Next GSQ-RCO packs from ISTA-DASLab, at one revision; SHA-256 of each file setup downloads
HF_REPO=ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF
